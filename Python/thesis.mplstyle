## Matplotlib style for figures that match the thesis.
## Use it with:   import matplotlib.pyplot as plt
##                plt.style.use("path/to/thesis.mplstyle")
## Then save figures as PDF and include them with \includegraphics, at the width they were made for
## (see the README for the text widths of each page size).

## --- Fonts: Times, like the text --------------------------------------------------------
## thesis_fonts.setup() (Python/thesis_fonts.py) replaces these with the thesis's own fonts, set by
## LuaLaTeX, or without LuaLaTeX with matplotlib's maths in Times New Roman. With this file alone: Times
## New Roman text if installed (Windows, macOS), otherwise STIX, a Times-like font that ships with
## matplotlib; STIX maths.
font.family:        serif
font.serif:         Times New Roman, STIXGeneral, Nimbus Roman, TeX Gyre Termes, DejaVu Serif
mathtext.fontset:   stix            # Times-like maths: $\alpha$, $C_L$, $U_\infty$
## Sizes, set for the Dover default (9.5 pt text, captions about 8.5 pt): figure text at about the
## caption size. For A5 and Royal (10 pt text), add 0.5 to each; for TU Delft (11 pt text), add 1.5.
font.size:          8.5
axes.titlesize:     8.5
axes.labelsize:     8.5
xtick.labelsize:    7.5
ytick.labelsize:    7.5
legend.fontsize:    7.5

## --- Size: full text width of the Dover book (91.5 mm); A5 99.5 mm, Royal 104.5 mm, TU Delft 112.5 mm --
## Change the width per figure with plt.figure(figsize=(width_in, height_in)).
figure.figsize:     3.60, 2.23      # inches: 91.5 mm wide, golden-ratio height
figure.dpi:         150
figure.constrained_layout.use: True
savefig.format:     pdf
savefig.bbox:       standard        # keep the exact figure size (no "tight" cropping)
savefig.dpi:        300             # for raster elements inside the PDF

## --- Colours: colour-blind safe, and line styles so lines stay apart in greyscale ----------
## Paul Tol's "bright" scheme (https://personal.sron.nl/~pault/), each colour with its own line style.
axes.prop_cycle:    (cycler('color', ['4477AA', 'EE6677', '228833', 'CCBB44', '66CCEE', 'AA3377', 'BBBBBB']) + cycler('linestyle', ['-', '--', '-.', ':', (0, (5, 1, 1, 1)), (0, (3, 1, 1, 1, 1, 1)), (0, (1, 2))]))

## --- Lines and axes ------------------------------------------------------------------------
lines.linewidth:    1.2
lines.markersize:   4
axes.linewidth:     0.6
axes.grid:          True
grid.color:         d9d9d9
grid.linewidth:     0.4
axes.axisbelow:     True
axes.spines.top:    False
axes.spines.right:  False
xtick.major.width:  0.6
ytick.major.width:  0.6
xtick.direction:    out
ytick.direction:    out
legend.frameon:     False

## --- PDF output: embed fonts as TrueType (Type 42), as needed for PDF/A ---------------------
pdf.fonttype:       42
ps.fonttype:        42
