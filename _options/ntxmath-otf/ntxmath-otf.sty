\def\MTP@resetmc{\ifnum\MTP@inalpha>\z@ \MTP@inalpha=\z@ \directlua{ntxmathotf.resetmc()}\fi}
\AddToHook{begindocument/end}{\directlua{
  local L, S = {}, {}
  for _, r in ipairs({{48, 57}, {65, 90}, {97, 122}, {913, 937}, {945, 969}, {977, 982}, {1008, 1013}, {8706, 8706}, {8711, 8711}}) do
    for c = r[1], r[2] do table.insert(L, c) S[c] = tex.getmathcode(c) end
  end
  function ntxmathotf.resetmc()
    for _, d in ipairs(L) do
      local m, s = tex.getmathcode(d), S[d]
      if not (m[1] == s[1] and m[2] == s[2] and m[3] == s[3]) then tex.setmathcode(d, s) end
    end
  end}%
  \everymath\expandafter{\the\everymath\MTP@resetmc}%
  \everydisplay\expandafter{\the\everydisplay\MTP@resetmc}%
  \def\MTP@tmp#1#2#3{\hbox{{\everymath{#1}\let\f@size#2\selectfont#3}}}% amsmath's \text sets \everymath
  \ifx\textdef@\MTP@tmp\def\textdef@#1#2#3{\hbox{{\everymath{#1\MTP@resetmc}\let\f@size#2\selectfont#3}}}\fi}
% microtype: the glyphs the Type 1 set-up takes from its operators font (a text font: digits,
% \mathrm letters, operator names, ...) get what microtype gives that font, protrusion and
% expansion included; the other glyphs get none, as with the Type 1 maths fonts. microtype is
% shown that font's name (encoding, family, series) for the maths fonts, so its settings and
% the document's \SetProtrusion/\SetExpansion apply as they would to the Type 1 font.
\directlua{ntxmathotf.mttext = {[33]=33,[34]=34,[36]=36,[48]=48,[49]=49,[50]=50,[51]=51,[52]=52,[53]=53,[54]=54,[55]=55,[56]=56,[57]=57,[59]=59,[63]=63,[64]=64,[65]=65,[66]=66,[67]=67,[68]=68,[69]=69,[70]=70,[71]=71,[72]=72,[73]=73,[74]=74,[75]=75,[76]=76,[77]=77,[78]=78,[79]=79,[80]=80,[81]=81,[82]=82,[83]=83,[84]=84,[85]=85,[86]=86,[87]=87,[88]=88,[89]=89,[90]=90,[96]=96,[97]=97,[98]=98,[99]=99,[100]=100,[101]=101,[102]=102,[103]=103,[104]=104,[105]=105,[106]=106,[107]=107,[108]=108,[109]=109,[110]=110,[111]=111,[112]=112,[113]=113,[114]=114,[115]=115,[116]=116,[117]=117,[118]=118,[119]=119,[120]=120,[121]=121,[122]=122,[8758]=58}}
\def\MTP@mt@name#1/#2/#3/#4/#5/#6\@nil{%
  \expandafter\in@\expandafter{\detokenize{NewTXMath}}{#2}% (#2: \string's characters)
  \ifin@
    \expandafter\in@\expandafter{\detokenize{-Bold}}{#2}\ifin@ \let\MTP@mt@ser\MTP@mt@bold \else
    \expandafter\in@\expandafter{\detokenize{-Heavy}}{#2}\ifin@ \let\MTP@mt@ser\MTP@mt@heavy \else \def\MTP@mt@ser{m}\fi\fi
    \edef\MTP@tmp{\noexpand\MTP@MT@split@name\detokenize\expandafter{\MTP@mt@enc}/%
      \detokenize\expandafter{\MTP@mt@fam}/\detokenize\expandafter{\MTP@mt@ser}/#4/#5/#6\noexpand\@nil}%
  \else \def\MTP@tmp{\MTP@MT@split@name#1/#2/#3/#4/#5/#6\@nil}\fi
  \MTP@tmp}
\AddToHook{begindocument/before}{\@ifpackageloaded{microtype}{%
  \let\MTP@MT@split@name\MT@split@name \let\MT@split@name\MTP@mt@name
  \g@addto@macro\MT@setupfont{\directlua{ntxmathotf.mtfix()}}%
  % (what microtype gives the Type 1 operators font itself, for slots the maths font lacks:
  % that font set up once, regular and bold, when the document starts)
  \AddToHook{begindocument/end}{\directlua{ntxmathotf.mtref = { m = {}, b = {} }}%
    \begingroup\fontencoding{\MTP@mt@enc}\fontfamily{\MTP@mt@fam}\fontseries{m}\fontshape{n}\selectfont
      \directlua{ntxmathotf.mtrefread("m")}\endgroup
    \begingroup\fontencoding{\MTP@mt@enc}\fontfamily{\MTP@mt@fam}\fontseries{\MTP@mt@bold}\fontshape{n}\selectfont
      \directlua{ntxmathotf.mtrefread("b")}\endgroup}%
  \directlua{
    local done, T = {}, ntxmathotf.mttext
    ntxmathotf.mtref, ntxmathotf.mtsaved = { m = {}, b = {} }, {}
    function ntxmathotf.mtrefread(s)
      local q = {}
      for c, v in pairs(T) do
        if not (c == v) then
          table.insert(q, "ntxmathotf.mtref." .. s .. "[" .. v .. "] = {\string\\the\string\\lpcode\string\\font" .. v
            .. ", \string\\the\string\\rpcode\string\\font" .. v .. ", \string\\the\string\\efcode\string\\font" .. v .. "} ")
        end
      end
      tex.sprint("\string\\directlua{" .. table.concat(q) .. "}")
    end
    function ntxmathotf.mtfix()
      local id = font.current()
      local L, R, E = "\string\\lpcode\string\\font", "\string\\rpcode\string\\font", "\string\\efcode\string\\font"
      local function set(c, v) return L .. c .. "=" .. v .. R .. c .. "=" .. v .. E .. c .. "=" .. v .. " " end
      if done[id] then
        % (the same font set up again under another name, e.g. Lite's bold version, which uses
        % the regular font: its codes as first set)
        local s = ntxmathotf.mtsaved[id]
        if s then
          local q = {}
          for c, r in pairs(s) do table.insert(q, L .. c .. "=" .. r[1] .. " " .. R .. c .. "=" .. r[2] .. " " .. E .. c .. "=" .. r[3] .. " ") end
          tex.sprint(table.concat(q))
        end
        return
      end
      done[id] = true
      local f = font.getfont(id)
      if not (f and f.name and f.name:find("NewTXMath", 1, true)) then return end
      local a, b = {}, {}
      local ref = ntxmathotf.mtref[f.name:find("-Bold", 1, true) and "b" or "m"]
      for c, v in pairs(T) do
        if not (c == v) then
          local r = not f.characters[v] and ref[v]
          if r then table.insert(a, L .. c .. "=" .. r[1] .. " " .. R .. c .. "=" .. r[2] .. " " .. E .. c .. "=" .. r[3] .. " ")
          else table.insert(a, L .. c .. "=" .. L .. v .. " " .. R .. c .. "=" .. R .. v .. " " .. E .. c .. "=" .. E .. v .. " ") end
        end
      end
      local q = {}
      for c in pairs(f.characters) do
        if not T[c] then table.insert(b, set(c, 0)); table.insert(q, "[" .. c .. "]={0,0,0}")
        else table.insert(q, "[" .. c .. "]={" .. "\string\\the" .. L .. c .. ",\string\\the" .. R .. c .. ",\string\\the" .. E .. c .. "}") end
      end
      tex.sprint(table.concat(a) .. table.concat(b) .. "\string\\directlua{ntxmathotf.mtsaved[" .. id .. "]={" .. table.concat(q, ",") .. "}}")
    end}}{}}
% newtxmath's classes of the ASCII symbols
\AddToHook{begindocument/end}{\directlua{for c, k in pairs({[33]=5,[34]=0,[35]=0,[36]=0,[37]=0,[38]=0,[40]=4,[41]=5,[42]=2,[43]=2,[44]=6,[45]=2,[46]=0,[47]=4,[58]=3,[59]=6,[60]=3,[61]=3,[62]=3,[63]=5,[64]=0,[91]=4,[92]=0,[93]=5,[94]=0,[96]=0,[123]=0,[124]=0,[125]=0,[126]=0}) do
  local m = tex.getmathcode(c)
  if type(m) == 'table' and m[1] < 8 and not (m[1] == k) then tex.setmathcode(c, {k, m[2], m[3]}) end
end}}
