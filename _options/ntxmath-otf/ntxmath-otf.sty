% arrows over formulas and \overbrace/\underbrace as LaTeX/amsmath build them (from
% pieces and rules) instead of unicode-math's stretchy glyphs
\AtBeginDocument{%
\DeclareRobustCommand\overrightarrow[1]{\vbox{\m@th\ialign{##\crcr
      \rightarrowfill\crcr\noalign{\kern-\p@\nointerlineskip}
      $\hfil\displaystyle{#1}\hfil$\crcr}}}%
\DeclareRobustCommand\overleftarrow[1]{\vbox{\m@th\ialign{##\crcr
      \leftarrowfill\crcr\noalign{\kern-\p@\nointerlineskip}%
      $\hfil\displaystyle{#1}\hfil$\crcr}}}%
\DeclareRobustCommand\overbrace[1]{\mathop{\vbox{\m@th\ialign{##\crcr\noalign{\kern3\p@}%
      \downbracefill\crcr\noalign{\kern3\p@\nointerlineskip}%
      $\hfil\displaystyle{#1}\hfil$\crcr}}}\limits}%
\DeclareRobustCommand\underbrace[1]{\mathop{\vtop{\m@th\ialign{##\crcr
   $\hfil\displaystyle{#1}\hfil$\crcr
   \noalign{\kern3\p@\nointerlineskip}%
   \upbracefill\crcr\noalign{\kern3\p@}}}}\limits}%
\DeclareRobustCommand\rightarrowfill{$\m@th\smash-\mkern-7mu%
  \cleaders\hbox{$\mkern-2mu\smash-\mkern-2mu$}\hfill
  \mkern-7mu\mathord\rightarrow$}%
\DeclareRobustCommand\leftarrowfill{$\m@th\mathord\leftarrow\mkern-7mu%
  \cleaders\hbox{$\mkern-2mu\smash-\mkern-2mu$}\hfill
  \mkern-7mu\smash-$}%
\DeclareRobustCommand\downbracefill{$\m@th \setbox\z@\hbox{$\braceld$}%
  \braceld\leaders\vrule \@height\ht\z@ \@depth\z@\hfill\braceru
  \bracelu\leaders\vrule \@height\ht\z@ \@depth\z@\hfill\bracerd$}%
\DeclareRobustCommand\upbracefill{$\m@th \setbox\z@\hbox{$\braceld$}%
  \bracelu\leaders\vrule \@height\ht\z@ \@depth\z@\hfill\bracerd
  \braceld\leaders\vrule \@height\ht\z@ \@depth\z@\hfill\braceru$}%
\@ifpackageloaded{amsmath}{%
\DeclareRobustCommand\overrightarrow{%
  \mathpalette{\overarrow@\rightarrowfill@}}%
\DeclareRobustCommand\overleftarrow{%
  \mathpalette{\overarrow@\leftarrowfill@}}%
\DeclareRobustCommand\overleftrightarrow{%
  \mathpalette{\overarrow@\leftrightarrowfill@}}%
\DeclareRobustCommand\underrightarrow{%
  \mathpalette{\underarrow@\rightarrowfill@}}%
\DeclareRobustCommand\underleftarrow{%
  \mathpalette{\underarrow@\leftarrowfill@}}%
\DeclareRobustCommand\underleftrightarrow{%
  \mathpalette{\underarrow@\leftrightarrowfill@}}%
}{}%
}

% unicode-math's commands whose character MTPro2 lacks: the definition a package gave them
% before (amsmath's \iiiint, \varTheta, ...), or else an error, not a blank
\def\MTP@nochar#1#2{\PackageError{ntxmath-otf}{\expandafter\string\csname#1\endcsname\space
  (U+#2) is not in the NewTX Math font}{newtxmath has no glyph for this character;
  with its Type 1 fonts the command is not defined either.}}
\AddToHook{begindocument/end}{\directlua{ntxmathotf.nochar()}}
% a formula nested in an alphabet switch starts with the document's letters, as with the
% Type 1 fonts, where the switch is \fam and TeX resets it at the start of every formula
% (\operatorname{inf\vphantom{p}}, \mathbb{x\phantom{y}}, \mathrm{x\text{$p$}}). unicode-math
% switches by changing mathcodes; the flag is set only for switches inside maths (unicode-math
% also switches outside), so packages that set mathcodes themselves (url) are left alone.
% (No ~ and no Lua comments here: babel makes ~ active, and newlines become spaces.)
\newcount\MTP@inalpha
\ExplSyntaxOn
\cs_set_protected:Nn \__um_switch_to:n { \tl_use:c {g__um_switchto_#1_tl} \ifmmode \MTP@inalpha=\@ne \fi }
