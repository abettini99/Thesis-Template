  \else\ensuremath{\bm{#1}}\fi}
\protected\def\hm#1{\relax\ifmmode\MTP@bmsize\begingroup\MTP@bmattr=2 #1\endgroup
  \else\ensuremath{\hm{#1}}\fi}
