## Matplotlib style for figures that match the thesis.
## Use it with:   import matplotlib.pyplot as plt
##                plt.style.use("path/to/thesis.mplstyle")
## Then save figures as PDF and include them with \includegraphics, at the width they were made for
## (see the README for the text widths of each page size).

## --- Fonts: Times, like the text --------------------------------------------------------
## thesis_fonts.setup() (figures/plots/thesis_fonts.py) replaces these with the thesis's own fonts, set by
## LuaLaTeX, or without LuaLaTeX with matplotlib's maths in Times New Roman. With this file alone: Times
## New Roman text if installed (Windows, macOS), otherwise STIX, a Times-like font that ships with
## matplotlib; STIX maths.
font.family:        serif
font.serif:         Times New Roman, STIXGeneral, Nimbus Roman, TeX Gyre Termes, DejaVu Serif
mathtext.fontset:   stix            # Times-like maths: $\alpha$, $C_L$, $U_\infty$
## Sizes, set for demy, A5 and royal (10 pt text, captions 9 pt): figure text at about the caption
## size. For the Dutch size (11 pt text), add 1 to each.
font.size:          9
axes.titlesize:     9
axes.labelsize:     9
xtick.labelsize:    8
ytick.labelsize:    8
legend.fontsize:    8

## --- Size: full text width of the demy book (91.5 mm); A5 99.5 mm, Royal 104.5 mm, Dutch 112.5 mm --
## Change the width per figure with plt.figure(figsize=(width_in, height_in)).
figure.figsize:     3.60, 2.23      # inches: 91.5 mm wide, golden-ratio height
figure.dpi:         150
figure.constrained_layout.use: True
savefig.format:     pdf
savefig.bbox:       standard        # keep the exact figure size (no "tight" cropping)
savefig.dpi:        300             # for raster elements inside the PDF

## --- Colours ------------------------------------------------------------------------------
## Lines and categories: "Earth", seven colours that all stand out against white (contrast 4.6:1 or
## more; the accessibility rule asks 3:1 for lines and 4.5:1 for text), each with its own line style,
## so lines stay apart in greyscale and for colour-blind readers.
##   slate blue 3B5B92, brick B5442E, olive 5E7D2B, plum 7A3E6E, ochre 9C6B00, teal 2A7B7B, charcoal 4D4D4D
## Colour maps: sequential data (magnitudes) viridis, the default below (or plasma); diverging data (signed
## values, centred on zero) RdBu_r, blue for negative and red for positive. thesis_fonts.SEQUENTIAL and
## thesis_fonts.DIVERGING name them. Not jet or other rainbow maps: their uneven brightness shows edges
## that are not in the data.
axes.prop_cycle:    (cycler('color', ['3B5B92', 'B5442E', '5E7D2B', '7A3E6E', '9C6B00', '2A7B7B', '4D4D4D']) + cycler('linestyle', ['-', '--', '-.', ':', (0, (5, 1, 1, 1)), (0, (3, 1, 1, 1, 1, 1)), (0, (1, 2))]))
image.cmap:         viridis

## --- Lines and axes ------------------------------------------------------------------------
lines.linewidth:    1.2
lines.markersize:   4
axes.linewidth:     0.6
axes.grid:          True
grid.color:         d9d9d9
grid.linewidth:     0.4
axes.axisbelow:     True
axes.spines.top:    False
axes.spines.right:  False
xtick.major.width:  0.6
ytick.major.width:  0.6
xtick.direction:    out
ytick.direction:    out
legend.frameon:     False

## --- PDF output: embed fonts as TrueType (Type 42), as needed for PDF/A ---------------------
pdf.fonttype:       42
ps.fonttype:        42
