# LaTeX build files (Overleaf does not sync these, but local builds create them)
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.glo
*.gls
*.glg
*.ist
*.lof
*.log
*.lot
*.out
*.run.xml
*.synctex.gz
*.toc
*.xmpi
_pagesizes_*
# tools/diff_versions.py output
*-diff.tex
*-diff.pdf
# tools/greyscale_preview.py output
*-grey.pdf

# MathTime Professional 2 (optional maths fonts): licensed to you alone. The originals, the zips and
# everything tools/mtpro2_otf.py writes into Fonts/ must never be committed. See Fonts/README.md.
*mtp2*/
*mtpro2*/
*mtp2*.zip
*mtpro2*.zip
*.pfb
*.pfm
*.afm
*.tfm
*.vf
*.otf
*.ttf
mtpro2.sty
mtpro2.map
mtpro2-glyphtounicode.tex
umt2*.fd
omslbm.fd
EULA-MTPro2*
# the converter's output: the fonts and its generated package, which holds metrics and macros taken
# from mtpro2.sty (the names above are the older Type 1 files, kept out too)
MTPro2Math*
mtpro2-otf*
*mtpro2-otf-build*
Fonts/*
!Fonts/README.md
__pycache__/
# the converters hold no font data: keep them
!tools/mtpro2_otf.py
!tools/ntxmath_otf.py
# newtx maths as OpenType (ntxmath-otf): free (LaTeX Project Public License), part of the template
!_options/ntxmath-otf/
!_options/ntxmath-otf/NewTXMath.otf
!_options/ntxmath-otf/NewTXMath-Bold.otf
!_options/josefin/JosefinSans-VF.ttf

# Build output
main.pdf
*.xdv
creationdate.lua
